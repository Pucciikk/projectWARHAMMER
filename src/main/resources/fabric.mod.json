{
  "schemaVersion": 1,
  "id": "warpbound",
  "version": "${version}",
  "name": "Warpbound",
  "description": "Фанатский мод по мотивам Warhammer 40k: корабли, варп, порча Хаоса.",
  "authors": [
    "Puccikk"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/warpbound/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.warpbound.Warpbound"
    ],
    "client": [
      "dev.warpbound.client.WarpboundClient"
    ],
    "fabric-datagen": [
      "dev.warpbound.client.datagen.WarpboundDataGenerator"
    ],
    "fabric-gametest": [
      "dev.warpbound.test.ShipyardGameTest",
      "dev.warpbound.test.IndustryGameTest",
      "dev.warpbound.test.ShipGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": ">=4.7"
  },
  "mixins": [
    "warpbound.mixins.json",
    {
      "config": "warpbound.client.mixins.json",
      "environment": "client"
    }
  ]
}
